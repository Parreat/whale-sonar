# Copy to .env (never commit it) and load it however your host does, e.g. `node --env-file=.env server/server.js`.
BASE_URL=https://whalesonar.example.com
PORT=3000
HOST=0.0.0.0
# Set to 1 only behind a reverse proxy you control (Caddy, nginx, Fly, Render...) so rate limits see real client IPs.
TRUST_PROXY=1
DATA_DIR=/var/lib/whale-sonar

# Email delivery (Postmark, Amazon SES, Mailgun, Resend... any SMTP). Use smtps:// or STARTTLS.
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
MAIL_FROM="Whale Sonar <daily@whalesonar.example.com>"

# Required by law in every newsletter (CAN-SPAM): a real street address, P.O. box, or registered private mailbox.
POSTAL_ADDRESS="123 Main St, Suite 100, Austin, TX 78701, USA"
# Who runs the site, shown in the Terms, Privacy Policy and Disclaimer.
OPERATOR_NAME="Example LLC"
CONTACT_EMAIL=privacy@whalesonar.example.com
GOVERNING_LAW="the State of Texas, USA"

# Newsletter data. Sending Finnhub data to subscribers is redistribution: check your Finnhub plan allows it.
FINNHUB_KEY=
NEWSLETTER_SEND_AT=07:30
NEWSLETTER_ENABLED=1
